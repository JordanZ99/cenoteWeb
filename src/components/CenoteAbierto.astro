---
// Cenote Abierto → ahora Santa Rosa Se Renueva
const features = [
  {
    number: '01',
    title: 'La Pirámide',
    desc: 'Una estructura ceremonial que honra la arquitectura maya y domina el horizonte de Homún, ofreciendo una experiencia inmersiva en la cultura ancestral.',
    icon: 'pyramid',
  },
  {
    number: '02',
    title: 'Museo Maya',
    desc: 'Un recorrido por la historia viva de los mayas: piezas arqueológicas, murales interactivos y narrativas que conectan el pasado con el presente.',
    icon: 'museum',
  },
  {
    number: '03',
    title: 'Videomapping',
    desc: 'El primer cenote en Yucatán con espectáculo de videomapping — proyecciones sobre piedra caliza que cuentan historias ancestrales bajo la tierra.',
    icon: 'projector',
  },
];
const slides = ['/seRenueva.jpg', '/seRenueva2.jpg', '/seRenueva3.jpg', '/seRenueva4.jpg'];
---

<section class="section sr-section" id="renovacion">
  <div class="section-inner">
    <!-- ─── Split: text (left) + slideshow (right) ─── -->
    <div class="sr-split">
      <!-- Left: text -->
      <div class="sr-text-col fade-left">
        <h2 class="sr-title">Santa Rosa Se Renueva</h2>
        <p class="sr-description">
          Estamos listos para compartir contigo una experiencia aún más mágica:
          Una majestuosa <strong>pirámide</strong>, un <strong>museo maya</strong> lleno de historia,
          ¡y el primer y único <strong>cenote con videomapping</strong> en su interior!
        </p>
        <p class="sr-description">
          Todo esto se suma a la belleza natural que ya conoces: 2 cenotes, restaurante,
          cabañas, huerto, zonas de descanso… y mucho más.
        </p>
        <p class="sr-description">
          Ven a conectar con la cultura maya y la naturaleza como nunca antes.
        </p>

        <div class="sr-info-box">
          <div class="sr-info-row">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/>
            </svg>
            <span>Todos los días de <strong>10:00 AM</strong> a <strong>6:00 PM</strong></span>
          </div>
          <div class="sr-info-row sr-info-row--alert">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/>
            </svg>
            <span>No se permite introducir alimentos, bebidas, hieleras, neveras, etc.</span>
          </div>
        </div>
      </div>

      <!-- Right: slideshow -->
      <div class="sr-slideshow-col fade-right">
        <div class="sr-slideshow">
          <div class="sr-slideshow-track" id="sr-slideshow">
            {slides.map((src, i) => (
              <img
                src={src}
                alt={`Santa Rosa Se Renueva ${i + 1}`}
                class="sr-slide"
                class:list={{ 'sr-slide--active': i === 0 }}
                loading={i === 0 ? 'eager' : 'lazy'}
              />
            ))}
          </div>
          <div class="sr-slideshow-dots" id="sr-dots">
            {slides.map((_, i) => (
              <span class="sr-dot" class:list={{ 'sr-dot--active': i === 0 }} data-index={i}></span>
            ))}
          </div>
        </div>
      </div>
    </div>

    <!-- ─── Feature cards ─── -->
    <div class="sr-grid fade-up">
      {features.map((f) => (
        <div class="sr-card">
          <div class="sr-card-bar"></div>
          <div class="sr-card-body">
            <div class="sr-card-icon-wrap">
              {f.icon === 'pyramid' && (
                <svg width="32" height="32" viewBox="0 0 36 36" fill="none" stroke="hsl(333, 72%, 52%)" stroke-width="1.4" aria-hidden="true">
                  <path d="M18 4L32 30H4L18 4Z"/><line x1="11" y1="20" x2="25" y2="20"/><line x1="8" y1="26" x2="28" y2="26"/>
                </svg>
              )}
              {f.icon === 'museum' && (
                <svg width="32" height="32" viewBox="0 0 36 36" fill="none" stroke="hsl(333, 72%, 52%)" stroke-width="1.4" aria-hidden="true">
                  <path d="M4 14H32V14L18 4L4 14Z"/>
                  <line x1="8" y1="14" x2="8" y2="32"/><line x1="14" y1="14" x2="14" y2="32"/>
                  <line x1="22" y1="14" x2="22" y2="32"/><line x1="28" y1="14" x2="28" y2="32"/>
                  <line x1="4" y1="32" x2="32" y2="32"/>
                </svg>
              )}
              {f.icon === 'projector' && (
                <svg width="32" height="32" viewBox="0 0 36 36" fill="none" stroke="hsl(333, 72%, 52%)" stroke-width="1.4" aria-hidden="true">
                  <rect x="8" y="6" width="20" height="14" rx="2"/><circle cx="18" cy="13" r="4"/>
                  <path d="M14 20v6M22 20v6"/><line x1="10" y1="26" x2="26" y2="26"/>
                </svg>
              )}
            </div>
            <span class="sr-card-number">{f.number}</span>
            <h3 class="sr-card-title">{f.title}</h3>
            <p class="sr-card-desc">{f.desc}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  // @ts-nocheck
  // ─── Slideshow ───
  (function() {
    const slides = document.querySelectorAll('.sr-slide');
    const dots = document.querySelectorAll('.sr-dot');
    if (slides.length < 2) return;
    let current = 0;
    setInterval(() => {
      slides[current].classList.remove('sr-slide--active');
      if (dots[current]) dots[current].classList.remove('sr-dot--active');
      current = (current + 1) % slides.length;
      slides[current].classList.add('sr-slide--active');
      if (dots[current]) dots[current].classList.add('sr-dot--active');
    }, 3500);
  })();

  // ─── Fade-up observer ───
  (function() {
    const els = document.querySelectorAll('#renovacion .fade-up, #renovacion .fade-left, #renovacion .fade-right');
    els.forEach(el => {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.15 });
      observer.observe(el);
    });
  })();
</script>

<style>
  /* ─── Section background ─── */
  .sr-section {
    background: var(--color-limestone);
    padding: clamp(80px, 10vw, 160px) 0;
  }

  /* ─── Split layout: text left, slideshow right ─── */
  .sr-split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(40px, 5vw, 80px);
    align-items: center;
    margin-bottom: clamp(56px, 6vw, 96px);
  }

  /* ─── Left: text column ─── */
  .sr-text-col {
    max-width: 580px;
  }

  .sr-title {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: clamp(36px, 5vw, 64px);
    color: hsl(333, 72%, 52%);
    line-height: 1.1;
    margin-bottom: 28px;
  }

  .sr-description {
    font-family: var(--font-body);
    font-weight: 300;
    font-size: 16px;
    color: var(--color-stone);
    opacity: 0.8;
    line-height: 1.8;
    margin-bottom: 16px;
  }

  .sr-description strong {
    font-weight: 600;
    color: hsl(333, 72%, 52%);
    opacity: 1;
  }

  /* ─── Info box (hours + alert) ─── */
  .sr-info-box {
    margin-top: 32px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .sr-info-row {
    display: flex;
    align-items: center;
    gap: 12px;
    font-family: var(--font-body);
    font-size: 14px;
    color: var(--color-stone);
    opacity: 0.85;
    line-height: 1.5;
  }

  .sr-info-row svg {
    flex-shrink: 0;
    opacity: 0.6;
  }

  .sr-info-row--alert {
    padding: 14px 16px;
    background: hsla(333, 72%, 52%, 0.06);
    border: 1px solid hsla(333, 72%, 52%, 0.15);
    border-radius: 8px;
    color: hsl(333, 50%, 35%);
    font-size: 13px;
  }

  .sr-info-row--alert svg {
    color: hsl(333, 72%, 52%);
    opacity: 0.8;
  }

  /* ─── Right: slideshow ─── */
  .sr-slideshow-col {
    position: relative;
  }

  .sr-slideshow {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 8px 32px rgba(0,0,0,0.08);
  }

  .sr-slideshow-track {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .sr-slide {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 0.8s ease;
  }

  .sr-slide--active {
    opacity: 1;
  }

  /* ─── Dots navigation ─── */
  .sr-slideshow-dots {
    position: absolute;
    bottom: 16px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 8px;
    z-index: 2;
  }

  .sr-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.4);
    transition: background 0.4s ease, transform 0.4s ease;
    cursor: default;
  }

  .sr-dot--active {
    background: hsl(333, 72%, 52%);
    transform: scale(1.3);
  }

  /* ─── Card grid ─── */
  .sr-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
  }

  .sr-card {
    position: relative;
    background: hsl(38, 28%, 80%);
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 2px 12px rgba(0,0,0,0.04);
    transition: transform 0.5s var(--ease-out-expo), box-shadow 0.5s var(--ease-out-expo);
  }

  .sr-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 12px 40px rgba(0,0,0,0.08);
  }

  .sr-card-bar {
    height: 4px;
    background: linear-gradient(90deg, hsl(333, 72%, 52%), hsl(333, 60%, 70%));
  }

  .sr-card-body {
    padding: clamp(24px, 2.5vw, 36px);
  }

  .sr-card-icon-wrap {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: hsla(333, 72%, 52%, 0.08);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 20px;
    transition: background 0.4s ease;
  }

  .sr-card:hover .sr-card-icon-wrap {
    background: hsla(333, 72%, 52%, 0.14);
  }

  .sr-card-number {
    display: inline-block;
    font-family: var(--font-body);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: hsl(333, 72%, 52%);
    opacity: 0.5;
    margin-bottom: 8px;
  }

  .sr-card-title {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: clamp(20px, 2.2vw, 26px);
    color: hsl(333, 72%, 52%);
    margin-bottom: 12px;
  }

  .sr-card-desc {
    font-family: var(--font-body);
    font-weight: 300;
    font-size: 15px;
    color: var(--color-stone);
    opacity: 0.75;
    line-height: 1.7;
  }

  /* ─── Responsive ─── */
  @media (max-width: 1000px) {
    .sr-split {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .sr-text-col {
      max-width: 100%;
    }

    .sr-slideshow {
      max-width: 600px;
      margin: 0 auto;
    }
  }

  @media (max-width: 900px) {
    .sr-grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .sr-card:hover {
      transform: translateY(-3px);
    }

    .sr-slideshow {
      border-radius: 8px;
    }
  }
</style>
