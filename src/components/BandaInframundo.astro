---
// BandaInframundo — Cinematic text interruption between sections
---

<section class="section banda-inframundo">
  <div class="section-inner">
    <h2 class="banda-text" id="banda-text">
      El inframundo maya, ahora iluminado.
    </h2>
  </div>
</section>

<script>
  // @ts-nocheck
  document.addEventListener('DOMContentLoaded', () => {
    const text = document.getElementById('banda-text');
    if (!text) return;

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.4 });

    observer.observe(text);
  });
</script>

<style>
  .banda-inframundo {
    background: var(--color-obsidian);
    padding: clamp(80px, 12vw, 140px) 0;
  }

  .banda-text {
    font-family: var(--font-heading);
    font-weight: 700;
    font-style: italic;
    font-size: clamp(48px, 6vw, 88px);
    color: var(--color-gold-light);
    text-align: center;
    line-height: 1.15;
    letter-spacing: 0.02em;

    /* Clip-path reveal */
    clip-path: inset(0 100% 0 0);
    transition: clip-path 1.2s var(--ease-out-expo);
  }

  .banda-text.is-visible {
    clip-path: inset(0 0% 0 0);
  }
</style>
