---
// Videomapping Section — scroll-driven image reveal
---

<section id="videomapping" class="section videomapping-section">
  <div class="videomapping-layout">
    <div class="videomapping-image" id="videomapping-reveal">
      <img
        src="videomapping2.jpg"
        alt="Videomapping en el Cenote Santa Rosa"
        class="videomapping-img"
        loading="lazy"
      />
    </div>
    <div class="videomapping-content">
      <div class="videomapping-text fade-right">
        <span class="badge">Homún, Yucatán</span>
        <h2 class="videomapping-title">15,000 Personas ya vieron nuestro videomapping</h2>
        <p class="videomapping-desc">
          Tu plan para este fin de semana, debería ser verlo por ti mismo. Tenemos proyecciones todos los sábado y domingos. ¡Vive la experiencia!
        </p>
        <div class="videomapping-data">
          <div class="data-row">
            <span class="data-row__label">Horario</span>
            <span class="data-row__value">Fines de semana y puentes festivos</span>
          </div>
          <div class="data-row">
            <span class="data-row__label">Funciones</span>
            <span class="data-row__value">11:00 AM — 4:00 PM</span>
          </div>
          <div class="data-row">
            <span class="data-row__label">Cupo</span>
            <span class="data-row__value">Limitado por función</span>
          </div>
          <div class="data-row">
            <span class="data-row__label">Producido por</span>
            <span class="data-row__value">NILU NILU</span>
          </div>
        </div>
        <a href="https://wa.me/529995085367?text=Hola,%20quiero%20asegurar%20mi%20lugar%20para%20el%20videomapping" class="cta-btn cta-btn--filled videomapping-cta" target="_blank" rel="noopener noreferrer">
          <span>Asegurar mi lugar</span>
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  // @ts-nocheck
  (function() {
    const el = document.getElementById('videomapping-reveal');
    if (!el) return;
    const img = el.querySelector('img');
    if (!img) return;

    let ticking = false;

    function onScroll() {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        const rect = el.getBoundingClientRect();
        const vh = window.innerHeight;
        const progress = Math.min(1, Math.max(0, (vh - rect.top) / (vh + rect.height)));
        const maxTranslate = el.offsetHeight * 0.3;
        const translateY = (0.2 - progress) * maxTranslate;
        img.style.transform = `translateY(${translateY}px) scale(1.1)`;
        ticking = false;
      });
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  })();
</script>

<style>
  .videomapping-section {
    background: var(--color-obsidian);
    padding: clamp(80px, 10vw, 160px) 0;
  }
  .videomapping-layout {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 clamp(20px, 4vw, 80px);
    display: grid;
    grid-template-columns: 55% 45%;
    gap: clamp(40px, 5vw, 80px);
    align-items: center;
  }
  .videomapping-image {
    overflow: hidden;
    border-radius: 4px;
    height: clamp(400px, 55vw, 700px);
  }
  .videomapping-img {
    width: 100%;
    height: 130%;
    object-fit: cover;
    object-position: center 40%;
    display: block;
    will-change: transform;
  }
  .videomapping-title {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: clamp(32px, 4vw, 52px);
    color: var(--color-limestone);
    margin: 24px 0;
    line-height: 1.1;
  }
  .videomapping-desc {
    font-family: var(--font-body);
    font-weight: 300;
    font-size: 16px;
    color: var(--color-limestone);
    opacity: 0.75;
    line-height: 1.8;
    margin-bottom: 40px;
  }
  .videomapping-data { margin-bottom: 48px; }
  .videomapping-cta { margin-top: 8px; }
  @media (max-width: 900px) {
    .videomapping-layout { grid-template-columns: 1fr; }
    .videomapping-image { height: 350px; }
  }
</style>
