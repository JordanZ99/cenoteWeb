---
// Cabañas — scroll-driven image reveal
---

<section id="cabanas" class="section cabanas-section">
  <div class="section-inner">
    <div class="cabanas-layout">
      <div class="cabanas-content">
        <div class="cabanas-text fade-left">
          <h2 class="cabanas-title">Cabañas</h2>
          <p class="cabanas-desc">
            Descansa en nuestras cabañas rodeadas de selva yucateca.
            Arquitectura rústica con todas las comodidades para que tu estancia sea inolvidable.
          </p>
          <div class="cabanas-highlight">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--color-gold)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/>
            </svg>
            <span>Base ideal para explorar los +20 cenotes de Homún</span>
          </div>
          <a href="https://wa.me/529995085367?text=Hola,%20quiero%20consultar%20disponibilidad%20de%20cabañas" class="cta-btn cta-btn--filled cabanas-cta" target="_blank" rel="noopener noreferrer">
            <span>Ver disponibilidad</span>
          </a>
        </div>
      </div>
      <div class="cabanas-image" id="cabanas-reveal">
        <img
          src="/cabaña.jpg"
          alt="Cabañas rodeadas de selva yucateca"
          class="cabanas-img"
          loading="lazy"
        />
      </div>
    </div>
  </div>
</section>

<script>
  // @ts-nocheck
  (function() {
    const el = document.getElementById('cabanas-reveal');
    if (!el) return;
    const img = el.querySelector('img');
    if (!img) return;

    let ticking = false;

    function onScroll() {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        const rect = el.getBoundingClientRect();
        const vh = window.innerHeight;
        const progress = Math.min(1, Math.max(0, (vh - rect.top) / (vh + rect.height)));
        const maxTranslate = el.offsetHeight * 0.3;
        const translateY = (0.5 - progress) * maxTranslate;
        img.style.transform = `translateY(${translateY}px) scale(1.1)`;
        ticking = false;
      });
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  })();
</script>

<style>
  .cabanas-section {
    background: var(--color-stone);
    padding: clamp(80px, 10vw, 160px) 0;
  }
  .cabanas-layout {
    display: grid; grid-template-columns: 45% 55%;
    gap: clamp(40px, 5vw, 80px); align-items: center;
  }
  .cabanas-title {
    font-family: var(--font-heading); font-weight: 700;
    font-size: clamp(36px, 5vw, 64px); color: var(--color-limestone); margin-bottom: 24px;
  }
  .cabanas-desc {
    font-family: var(--font-body); font-weight: 300; font-size: 16px;
    color: var(--color-limestone); opacity: 0.75; line-height: 1.8; margin-bottom: 32px;
  }
  .cabanas-highlight {
    display: flex; align-items: center; gap: 12px;
    padding: 20px 24px; border: 1px solid rgba(201, 168, 76, 0.2);
    border-radius: 4px; background: rgba(201, 168, 76, 0.04); margin-bottom: 40px;
  }
  .cabanas-highlight span {
    font-family: var(--font-body); font-size: 15px; font-weight: 500; color: var(--color-gold-light);
  }
  .cabanas-image {
    overflow: hidden;
    border-radius: 4px;
    height: clamp(350px, 50vw, 600px);
  }
  .cabanas-img {
    width: 100%;
    height: 130%;
    object-fit: cover;
    object-position: center 30%;
    display: block;
    will-change: transform;
  }
  .cabanas-cta { margin-top: 0; }
  @media (max-width: 900px) {
    .cabanas-layout { grid-template-columns: 1fr; }
    .cabanas-image { height: 300px; }
  }
</style>
