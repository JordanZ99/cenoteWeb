---
// Renovación — Horizontal scroll section on vertical scroll
const features = [
  { title: 'La Pirámide', desc: 'Una estructura ceremonial que honra la arquitectura maya y domina el horizonte de Homún, ofreciendo una experiencia inmersiva en la cultura ancestral.', icon: 'pyramid' },
  { title: 'Museo Maya', desc: 'Un recorrido por la historia viva de los mayas: piezas arqueológicas, murales interactivos y narrativas que conectan el pasado con el presente.', icon: 'museum' },
  { title: 'Videomapping', desc: 'El primer cenote en Yucatán con espectáculo de videomapping — proyecciones sobre piedra caliza que cuentan historias ancestrales bajo la tierra.', icon: 'projector' },
];
---

<section class="section renovacion-section" id="renovacion">
  <div class="renovacion-bg"></div>
  <div class="renovacion-content">
    <div class="section-inner">
      <h2 class="renovacion-title fade-up">Santa Rosa Se Renueva</h2>
    </div>

    <!-- Horizontal scroll track -->
    <div class="renovacion-track" id="renovacion-track">
      <div class="renovacion-cards" id="renovacion-cards">
        {features.map((f, i) => (
          <div class="renovacion-card">
            <div class="renovacion-card-number">0{i + 1}</div>
            <div class="renovacion-card-icon">
              {f.icon === 'pyramid' && (
                <svg width="40" height="40" viewBox="0 0 36 36" fill="none" stroke="var(--color-gold)" stroke-width="1.2" aria-hidden="true">
                  <path d="M18 4L32 30H4L18 4Z"/><line x1="11" y1="20" x2="25" y2="20"/><line x1="8" y1="26" x2="28" y2="26"/>
                </svg>
              )}
              {f.icon === 'museum' && (
                <svg width="40" height="40" viewBox="0 0 36 36" fill="none" stroke="var(--color-gold)" stroke-width="1.2" aria-hidden="true">
                  <path d="M4 14H32V14L18 4L4 14Z"/>
                  <line x1="8" y1="14" x2="8" y2="32"/><line x1="14" y1="14" x2="14" y2="32"/>
                  <line x1="22" y1="14" x2="22" y2="32"/><line x1="28" y1="14" x2="28" y2="32"/>
                  <line x1="4" y1="32" x2="32" y2="32"/>
                </svg>
              )}
              {f.icon === 'projector' && (
                <svg width="40" height="40" viewBox="0 0 36 36" fill="none" stroke="var(--color-gold)" stroke-width="1.2" aria-hidden="true">
                  <rect x="8" y="6" width="20" height="14" rx="2"/><circle cx="18" cy="13" r="4"/>
                  <path d="M14 20v6M22 20v6"/><line x1="10" y1="26" x2="26" y2="26"/>
                </svg>
              )}
            </div>
            <h3 class="renovacion-card-title">{f.title}</h3>
            <p class="renovacion-card-desc">{f.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  // @ts-nocheck
  document.addEventListener('DOMContentLoaded', () => {
    const track = document.getElementById('renovacion-track');
    const cards = document.getElementById('renovacion-cards');
    if (!track || !cards) return;

    let ticking = false;
    window.addEventListener('scroll', () => {
      if (!ticking) {
        requestAnimationFrame(() => {
          const rect = track.getBoundingClientRect();
          const vh = window.innerHeight;

          // Only animate when the track is in view
          if (rect.top < vh && rect.bottom > 0) {
            // Progress: 0 when track top hits viewport bottom, 1 when track bottom hits viewport top
            const progress = Math.max(0, Math.min(1,
              (vh - rect.top) / (vh + rect.height)
            ));

            // Calculate how far to scroll horizontally
            const maxScroll = cards.scrollWidth - track.clientWidth;
            const scrollX = progress * maxScroll;

            cards.style.transform = `translateX(${-scrollX}px)`;
          }

          ticking = false;
        });
        ticking = true;
      }
    });
  });
</script>

<style>
  .renovacion-section {
    background: var(--color-obsidian);
    padding: clamp(80px, 10vw, 160px) 0 0;
    position: relative;
    overflow: hidden;
  }
  .renovacion-bg {
    position: absolute; inset: 0; z-index: 0;
    background: linear-gradient(135deg, var(--color-obsidian) 0%, var(--color-stone) 40%, rgba(201,168,76,0.05) 100%);
  }
  .renovacion-content { position: relative; z-index: 1; }
  .renovacion-title {
    font-family: var(--font-heading); font-weight: 700;
    font-size: clamp(36px, 5vw, 64px); color: var(--color-gold-light);
    text-align: center; margin-bottom: clamp(48px, 6vw, 80px);
  }

  /* ─── Horizontal scroll track ─── */
  .renovacion-track {
    overflow: hidden;
    padding: 0 clamp(20px, 4vw, 80px);
  }

  .renovacion-cards {
    display: flex;
    gap: 32px;
    width: max-content;
    will-change: transform;
  }

  .renovacion-card {
    width: clamp(320px, 35vw, 420px);
    flex-shrink: 0;
    padding: clamp(28px, 3vw, 40px);
    background: rgba(201, 168, 76, 0.05);
    border: 1px solid rgba(201, 168, 76, 0.15);
    border-radius: 4px;
    transition: background 0.4s ease, border-color 0.4s ease;
  }

  .renovacion-card:hover {
    background: rgba(201, 168, 76, 0.08);
    border-color: rgba(201, 168, 76, 0.25);
  }

  .renovacion-card-number {
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.15em;
    color: var(--color-gold);
    margin-bottom: 20px;
    opacity: 0.6;
  }

  .renovacion-card-icon { margin-bottom: 24px; }

  .renovacion-card-title {
    font-family: var(--font-heading); font-weight: 600;
    font-size: clamp(22px, 2.5vw, 28px); color: var(--color-gold-light); margin-bottom: 16px;
  }

  .renovacion-card-desc {
    font-family: var(--font-body); font-weight: 300; font-size: 15px;
    color: var(--color-limestone); opacity: 0.7; line-height: 1.7;
  }

  @media (max-width: 900px) {
    .renovacion-cards {
      width: auto;
      flex-direction: column;
      transform: none !important;
    }
    .renovacion-card {
      width: 100%;
    }
  }
</style>
