---
// Preloader Component
---

<div id="preloader">
  <div class="preloader-inner">
    <h1 class="preloader-text">SANTA ROSA</h1>
  </div>
  <div class="preloader-bar">
    <div class="preloader-bar-fill"></div>
  </div>
</div>

<script>
  // @ts-nocheck
  document.addEventListener('DOMContentLoaded', () => {
    const preloader = document.getElementById('preloader');
    const fill = document.querySelector('.preloader-bar-fill');
    if (!preloader || !fill) return;

    // ─── Build the 24 Hero animation frames ───
    // Odd-numbered scenes: scene00001, 00003, 00005 … 00047
    const TOTAL_FRAMES = 24;
    const frameUrls = [];
    for (let i = 1; i <= TOTAL_FRAMES; i++) {
      const num = String(2 * i - 1).padStart(5, '0');
      frameUrls.push(`/HeroAnimated/scene${num}.webp`);
    }

    let loaded = 0;

    function updateProgress() {
      loaded++;
      const pct = Math.round((loaded / TOTAL_FRAMES) * 100);
      fill.style.width = pct + '%';

      if (loaded >= TOTAL_FRAMES) {
        fill.style.width = '100%';
        // Small pause so user can see 100% before revealing
        setTimeout(() => {
          preloader.style.clipPath = 'inset(0 0 100% 0)';
          setTimeout(() => {
            preloader.style.display = 'none';
            document.dispatchEvent(new CustomEvent('preloader:done'));
          }, 1000);
        }, 400);
      }
    }

    // ─── Start loading all frames ───
    frameUrls.forEach((url) => {
      const img = new Image();
      img.onload = updateProgress;
      img.onerror = updateProgress; // count errors too so bar doesn't stall
      img.src = url;
    });
  });
</script>

<style>
  #preloader {
    position: fixed;
    inset: 0;
    background: var(--color-obsidian);
    z-index: 9999;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    transition: clip-path 1s var(--ease-in-out);
    clip-path: inset(0 0 0 0);
  }

  .preloader-inner {
    opacity: 0;
    animation: preloaderFadeIn 1.5s ease forwards;
  }

  .preloader-text {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: clamp(36px, 8vw, 72px);
    letter-spacing: 0.2em;
    color: var(--color-gold-light);
    text-transform: uppercase;
  }

  .preloader-bar {
    position: absolute;
    bottom: 60px;
    left: 50%;
    transform: translateX(-50%);
    width: min(280px, 60vw);
    height: 2px;
    background: rgba(201, 168, 76, 0.15);
    overflow: hidden;
  }

  .preloader-bar-fill {
    height: 100%;
    width: 0%;
    background: var(--color-gold);
    transition: width 0.1s linear;
  }

  @keyframes preloaderFadeIn {
    to { opacity: 1; }
  }
</style>
