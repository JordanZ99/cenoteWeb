---
// Navigation Component

// ─── GradualBlur layers (React Bits concept, native HTML/CSS) ───
const BLUR_COUNT = 12;
const BLUR_STRENGTH = 1.2;

function bezier(p) {
  return p * p * (3 - 2 * p);
}

interface BlurLayer {
  blur: string;
  mask: string;
}

const blurLayers: BlurLayer[] = (() => {
  const layers: BlurLayer[] = [];
  for (let i = 1; i <= BLUR_COUNT; i++) {
    // Reversed: top layers (i=1) get strong blur, bottom layers (i=12) get weak blur
    const progress = 1 - i / BLUR_COUNT;
    const curveVal = bezier(progress);
    const blurValue = Math.pow(2, curveVal * 4) * 0.0625 * BLUR_STRENGTH;
    const increment = 100 / BLUR_COUNT;
    const p1 = Math.round((increment * i - increment) * 10) / 10;
    const p2 = Math.round(increment * i * 10) / 10;
    const p3 = Math.round((increment * i + increment) * 10) / 10;
    const p4 = Math.round((increment * i + increment * 2) * 10) / 10;
    let gradient = `transparent ${p1}%, black ${p2}%`;
    if (p3 <= 100) gradient += `, black ${p3}%`;
    if (p4 <= 100) gradient += `, transparent ${p4}%`;
    layers.push({ blur: `${blurValue.toFixed(3)}rem`, mask: gradient });
  }
  return layers;
})();
const links = [
  { label: 'Cenotes', href: '#cenotes' },
  { label: 'Videomapping', href: '#videomapping' },
  { label: 'Restaurante', href: '#restaurante' },
  { label: 'Cabañas', href: '#cabanas' },
  { label: 'Ceremonias', href: '#ceremonias' },
  { label: 'Ubicación', href: '#ubicacion' },
];
---

<nav id="main-nav">
  <div class="nav-gradual-blur">
    <!-- Sutil viñeta oscura en la parte superior para contrastar los botones -->
    <div class="nav-vignette"></div>
    {blurLayers.map((layer, index) => (
      <div
        class="nav-blur-slice"
        style={{
          position: 'absolute',
          inset: 0,
          WebkitMaskImage: `linear-gradient(to bottom, ${layer.mask})`,
          maskImage: `linear-gradient(to bottom, ${layer.mask})`,
          backdropFilter: `blur(${layer.blur})`,
          WebkitBackdropFilter: `blur(${layer.blur})`,
          pointerEvents: 'none',
          zIndex: index + 1
        }}
      ></div>
    ))}
  </div>
  <div class="nav-inner">
    <a href="/" class="nav-logo">
      <span class="nav-logo-text">SANTA ROSA</span>
    </a>
    <ul class="nav-links">
      {links.map((link) => (
        <li><a href={link.href}>{link.label}</a></li>
      ))}
    </ul>
    <a href="https://wa.me/529995085367" class="nav-cta" target="_blank" rel="noopener noreferrer">Reservar</a>
    <button class="nav-hamburger" id="nav-toggle" aria-label="Abrir menú" aria-expanded="false" aria-controls="mobile-drawer">
      <span></span><span></span><span></span>
    </button>
  </div>
</nav>

<div id="mobile-drawer" class="mobile-drawer" role="dialog" aria-label="Menú de navegación" aria-hidden="true">
  <div class="drawer-header">
    <button id="drawer-close" aria-label="Cerrar menú">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
        <line x1="4" y1="4" x2="20" y2="20"/><line x1="20" y1="4" x2="4" y2="20"/>
      </svg>
    </button>
  </div>
  <ul class="drawer-links">
    {links.map((link) => (
      <li><a href={link.href}>{link.label}</a></li>
    ))}
  </ul>
  <a href="https://wa.me/529995085367" class="drawer-cta" target="_blank" rel="noopener noreferrer">Reservar ahora</a>
</div>

<script>
  // @ts-nocheck
  document.addEventListener('DOMContentLoaded', () => {
    const nav = document.getElementById('main-nav');
    const toggle = document.getElementById('nav-toggle');
    const drawer = document.getElementById('mobile-drawer');
    const closeBtn = document.getElementById('drawer-close');

    // ─── Show nav on first scroll ───
    let navRevealed = false;
    function revealNav() {
      if (navRevealed) return;
      navRevealed = true;
      nav.style.pointerEvents = 'auto';
      if (window.gsap) {
        window.gsap.to(nav, { opacity: 1, duration: 0.8, ease: 'power2.out' });
      } else {
        nav.style.opacity = '1';
      }
    }

    const onFirstScroll = () => {
      if (window.scrollY > 0) {
        revealNav();
        window.removeEventListener('scroll', onFirstScroll);
      }
    };
    window.addEventListener('scroll', onFirstScroll, { passive: true });

    function openDrawer() {
      drawer.classList.add('open');
      drawer.setAttribute('aria-hidden', 'false');
      toggle.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
    }
    function closeDrawer() {
      drawer.classList.remove('open');
      drawer.setAttribute('aria-hidden', 'true');
      toggle.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
    }

    toggle.addEventListener('click', openDrawer);
    closeBtn.addEventListener('click', closeDrawer);
    drawer.querySelectorAll('a').forEach((a) => a.addEventListener('click', closeDrawer));
  });
</script>

<style>
  #main-nav {
    position: fixed;
    top: 0; left: 0;
    width: 100%;
    z-index: 1000;
    padding: 24px 0;
    transition: all 0.5s var(--ease-out-expo);
    background: transparent;
    opacity: 0;
    pointer-events: none;
  }

  .nav-gradual-blur {
    position: absolute;
    top: -20px;
    left: 0;
    right: 0;
    height: calc(100% + 20px);
    z-index: -1;
    isolation: isolate;
    pointer-events: none;
  }
  .nav-blur-slice {
    z-index: auto;
  }
  .nav-vignette {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg,
      rgba(13, 11, 8, 0.95) 0%,
      rgba(13, 11, 8, 0.6) 45%,
      transparent 95%
    );
    z-index: 13;
    pointer-events: none;
  }

  .nav-inner {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 clamp(20px, 4vw, 80px);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .nav-logo-text {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 20px;
    letter-spacing: 0.15em;
    color: var(--color-limestone);
    text-transform: uppercase;
  }
  /* Nav stays the same, only background changes */

  .nav-links {
    list-style: none;
    display: flex;
    gap: clamp(20px, 3vw, 40px);
  }
  .nav-links a {
    font-family: var(--font-heading);
    font-size: 15px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--color-limestone);
    transition: color 0.3s ease;
    position: relative;
  }
  .nav-links a::after {
    content: '';
    position: absolute;
    bottom: -4px; left: 0;
    width: 0; height: 1px;
    background: var(--color-gold);
    transition: width 0.4s var(--ease-out-expo);
  }
  .nav-links a:hover { color: var(--color-gold); }
  .nav-links a:hover::after { width: 100%; }

  .nav-cta {
    padding: 10px 28px;
    border: 1px solid var(--color-gold);
    color: var(--color-gold);
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    transition: all 0.4s var(--ease-out-expo);
  }
  .nav-cta:hover { background: var(--color-gold); color: var(--color-obsidian); }

  .nav-hamburger {
    display: none;
    flex-direction: column;
    gap: 5px;
    padding: 8px;
    z-index: 1001;
  }
  .nav-hamburger span {
    width: 24px; height: 1.5px;
    background: var(--color-limestone);
    transition: all 0.3s ease;
  }

  /* Mobile Drawer */
  .mobile-drawer {
    position: fixed;
    top: 0; right: 0;
    width: min(380px, 85vw);
    height: 100vh;
    background: rgba(44, 36, 22, 0.98);
    backdrop-filter: blur(30px);
    z-index: 2000;
    transform: translateX(100%);
    transition: transform 0.5s var(--ease-out-expo);
    display: flex;
    flex-direction: column;
    padding: 32px;
  }
  .mobile-drawer.open { transform: translateX(0); }

  .drawer-header { display: flex; justify-content: flex-end; margin-bottom: 48px; }
  .drawer-header button { color: var(--color-limestone); padding: 8px; }

  .drawer-links { list-style: none; display: flex; flex-direction: column; flex: 1; }
  .drawer-links li { border-bottom: 1px solid rgba(232, 220, 200, 0.08); }
  .drawer-links a {
    display: block; padding: 20px 0;
    font-family: var(--font-heading); font-size: 24px; font-weight: 500;
    text-transform: uppercase; letter-spacing: 0.1em;
    color: var(--color-limestone);
    transition: color 0.3s ease;
  }
  .drawer-links a:hover { color: var(--color-gold); }

  .drawer-cta {
    display: block; text-align: center; padding: 18px;
    border: 1px solid var(--color-gold); color: var(--color-gold);
    font-family: var(--font-heading); font-weight: 600; font-size: 16px;
    text-transform: uppercase; letter-spacing: 0.1em;
    transition: all 0.4s ease; margin-top: auto;
  }
  .drawer-cta:hover { background: var(--color-gold); color: var(--color-obsidian); }

  @media (max-width: 900px) {
    .nav-links, .nav-cta { display: none; }
    .nav-hamburger { display: flex; }
  }
</style>
