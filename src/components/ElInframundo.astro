---
// El Inframundo — Numbered cenote section with gradient overlay
---

<section id="cenotes" class="section el-inframundo">
  <div class="inframundo-image-wrapper">
    <img
      src="/cenoteSubterraneo.jpg"
      alt="Cenote Subterráneo"
      class="inframundo-bg-img"
      loading="lazy"
    />
    <div class="inframundo-image-overlay"></div>

    <!-- Number + Title over the image -->
    <div class="inframundo-image-text">
      <span class="inframundo-number">01</span>
      <h2 class="inframundo-title inframundo-animate">Cenote Subterráneo</h2>
    </div>
  </div>

  <!-- Description and stats below the image -->
  <div class="inframundo-details">
    <div class="inframundo-details-inner">
      <p class="inframundo-desc inframundo-animate">
        Desciende al corazón de la tierra y contempla un mundo de piedra caliza, aguas cristalinas y formaciones milenarias que han resistido el paso del tiempo.
      </p>
      <div class="inframundo-stats inframundo-animate">
        <div class="inframundo-stat">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--color-gold)" stroke-width="1.5" aria-hidden="true">
            <path d="M12 2v20M8 6l4-4 4 4M6 12h12"/>
          </svg>
          <span>Estalactitas milenarias</span>
        </div>
        <div class="inframundo-stat">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--color-cenote)" stroke-width="1.5" aria-hidden="true">
            <circle cx="12" cy="12" r="10"/>
            <path d="M8 12c0-2.2 1.8-4 4-4s4 1.8 4 4-1.8 4-4 4-4-1.8-4-4z"/>
          </svg>
          <span>Aguas cristalinas</span>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // @ts-nocheck
  document.addEventListener('DOMContentLoaded', () => {
    const items = document.querySelectorAll('.inframundo-animate');
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.3 });
    items.forEach((item) => observer.observe(item));

    // Parallax on the image
    const img = document.querySelector('.inframundo-bg-img');
    if (!img) return;
    let ticking = false;
    window.addEventListener('scroll', () => {
      if (!ticking) {
        requestAnimationFrame(() => {
          const rect = img.closest('.el-inframundo').getBoundingClientRect();
          if (rect.top < window.innerHeight && rect.bottom > 0) {
            const progress = -rect.top / window.innerHeight;
            img.style.transform = `translateY(${progress * 50}px) scale(1.05)`;
          }
          ticking = false;
        });
        ticking = true;
      }
    });
  });
</script>

<style>
  .el-inframundo {
    width: 100%;
  }

  /* ─── Image area ─── */
  .inframundo-image-wrapper {
    position: relative;
    width: 100%;
    height: 70vh;
    min-height: 500px;
    overflow: hidden;
  }

  .inframundo-bg-img {
    width: 100%;
    height: 120%;
    object-fit: cover;
    object-position: center;
    transform: scale(1.05);
    will-change: transform;
  }

  .inframundo-image-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(13, 11, 8, 0.85) 0%, transparent 60%);
  }

  .inframundo-image-text {
    position: absolute;
    bottom: clamp(40px, 6vw, 80px);
    left: clamp(24px, 5vw, 80px);
    z-index: 1;
  }

  .inframundo-number {
    display: block;
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.15em;
    color: var(--color-gold);
    margin-bottom: 12px;
  }

  .inframundo-title {
    font-family: var(--font-heading);
    font-variant: small-caps;
    font-weight: 700;
    font-size: clamp(40px, 5.5vw, 76px);
    color: var(--color-limestone);
    letter-spacing: 0.02em;
    line-height: 1.05;
    text-shadow: 0 2px 40px rgba(0,0,0,0.3);
  }

  /* ─── Details below image ─── */
  .inframundo-details {
    background: var(--color-obsidian);
    padding: clamp(48px, 6vw, 80px) 0;
  }

  .inframundo-details-inner {
    max-width: 700px;
    margin: 0 auto;
    padding: 0 clamp(24px, 5vw, 80px);
  }

  .inframundo-desc {
    font-family: var(--font-body);
    font-weight: 300;
    font-size: clamp(16px, 1.6vw, 19px);
    color: var(--color-limestone);
    opacity: 0.8;
    line-height: 1.8;
    margin-bottom: 40px;
  }

  .inframundo-stats {
    display: flex;
    gap: clamp(24px, 4vw, 48px);
    flex-wrap: wrap;
  }

  .inframundo-stat {
    display: flex;
    align-items: center;
    gap: 12px;
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-limestone);
    padding: 12px 20px;
    border: 1px solid rgba(201, 168, 76, 0.2);
    border-radius: 4px;
  }

  /* ─── Entrance animations ─── */
  .inframundo-animate {
    opacity: 0;
    transform: translateY(40px);
    transition: opacity 0.9s var(--ease-out-expo), transform 0.9s var(--ease-out-expo);
  }

  .inframundo-animate.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .inframundo-animate:nth-child(2) { transition-delay: 0.15s; }
  .inframundo-animate:nth-child(3) { transition-delay: 0.3s; }
</style>
