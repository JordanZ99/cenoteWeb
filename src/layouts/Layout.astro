---
export interface Props {
  title?: string;
}

const { title = 'Cenote Santa Rosa — Homún, Yucatán' } = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Cenote Santa Rosa — Una experiencia mágica llena de naturaleza y cultura milenaria en Homún, Yucatán. Cenote subterráneo, videomapping maya, restaurante y cabañas." />
  <title>{title}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600;1,700&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js" defer></script>
  <!-- Force scroll to top on reload so Hero animation always starts from the beginning -->
  <script is:inline>
    if ('scrollRestoration' in history) {
      history.scrollRestoration = 'manual';
    }
    window.scrollTo(0, 0);
  </script>
</head>
<body>
  <!-- Skip to content for accessibility -->
  <a href="#cenotes" class="skip-link">Saltar al contenido principal</a>
  <slot />
  <script>
    // @ts-nocheck
    document.addEventListener('DOMContentLoaded', () => {
      // Global IntersectionObserver for fade animations
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      }, { rootMargin: '0px 0px -60px 0px', threshold: 0.1 });

      document.querySelectorAll('.fade-up, .fade-right, .fade-left').forEach((el) => {
        observer.observe(el);
      });
    });
  </script>
</body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
